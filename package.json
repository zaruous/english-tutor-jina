{
  "name": "jina-english-tutor",
  "version": "0.1.0-prototype",
  "description": "AI English Tutor for Korean learners — TOEIC/TOEFL prep with live AI conversation",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "node server.js",
    "dev:api": "node api/server.js",
    "dev:all": "node scripts/dev-all.mjs",
    "start": "node server.js",
    "api": "node api/server.js",
    "db:migrate": "node db/migrate.mjs up",
    "db:status": "node db/migrate.mjs status",
    "db:rollback": "node db/migrate.mjs down",
    "db:seed": "node db/seeds/dev.mjs",
    "db:seed:content": "node db/seeds/content.mjs",
    "db:reset": "node db/migrate.mjs reset",
    "db:verify": "node db/verify.mjs",
    "db:new": "node db/new-migration.mjs",
    "db:inspect": "node db/inspect.mjs",
    "e2e:admin-users": "node scripts/e2e-admin-users.mjs",
    "e2e:admin-authoring": "node scripts/e2e-admin-authoring.mjs",
    "verify:draft-review": "node scripts/verify-draft-review.mjs",
    "verify:content-status": "node scripts/verify-content-status.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "test": "node --import ./tests/setup.mjs --test tests/*.test.mjs",
    "test:pg": "DB_DRIVER=pg node --import ./tests/setup.mjs --test tests/*.test.mjs",
    "lint": "eslint .",
    "ollama": "OLLAMA_ORIGINS=\"*\" ollama serve",
    "ollama:pull": "ollama pull gemma4:e2b",
    "ollama:list": "ollama list"
  },
  "keywords": [
    "english-learning",
    "toeic",
    "toefl",
    "ai-tutor",
    "ollama",
    "claude",
    "korean"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "eslint": "9.39.0",
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
