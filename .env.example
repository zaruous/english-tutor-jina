# ── 정적 서버 (server.js) ─────────────────────────────
# AI Provider: claude | agy | codex | cursor | ollama
PORT=3003
AI_PROVIDER=claude
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
CLAUDE_MODEL=claude-haiku-4-5

# ── API 서버 (api/server.js) ──────────────────────────
API_PORT=3004
API_ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003
APP_TZ=Asia/Seoul

# DB 드라이버 — 방언은 하나(PostgreSQL)고 실행 방식만 둘이다 (플랜 10.7)
#   pg      기본. 실 PostgreSQL. 아래 PG* 가 필요하다
#   pglite  테스트·실험용 WASM PostgreSQL. 설치도 PG* 도 필요 없다 (npm test 가 이 값을 쓴다)
DB_DRIVER=pg
DB_SCHEMA=jina
# pglite 전용 — 비우면 메모리(프로세스마다 새 DB), 경로를 주면 파일 영속.
# 파일 DB 는 한 번에 한 프로세스만 열 수 있다 — 마이그레이션·시드는 API 서버를 멈춘 뒤에 (db/README.md)
PGLITE_DATA_DIR=

# PostgreSQL — 실제 값은 git에 추적되지 않는 .env에만 둔다
PGHOST=<DB_HOST>
PGPORT=<DB_PORT>
PGDATABASE=jina
PGUSER=<DB_USER>
PGPASSWORD=<DB_PASSWORD>
PG_POOL_MAX=8
PG_STATEMENT_TIMEOUT_MS=5000

# 인증
COOKIE_NAME=jina_sid
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# DEV_AUTOLOGIN=1 이면 쿠키 없는 요청에 개발 계정 세션을 자동 발급 (production 부팅 거부)
DEV_AUTOLOGIN=1
DEV_USER_EMAIL=jina@dev.local
DEV_USER_PASSWORD=<DEV_PASSWORD>

# 기본 관리자 계정 — API 서버 부팅 시 이 값으로 생성/갱신된다 (users.is_admin = true).
# 로그인 화면에 ADMIN_USERNAME 을 그대로 입력하면 ADMIN_EMAIL 로 치환해 인증한다
# (DB users.email 에 이메일 형태 CHECK 가 있어 'admin' 자체는 저장할 수 없다).
# ADMIN_AUTO_PROVISION=0 이면 자동 생성을 끈다. production 은 8자 이상을 요구한다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
ADMIN_EMAIL=admin@jina.local
ADMIN_DISPLAY_NAME=관리자
ADMIN_AUTO_PROVISION=1

# AI
AI_MAX_CONCURRENCY=2
AI_QUEUE_MAX=8
AGY_MODEL=gemini-3.7-flash-low
CURSOR_MODEL=gpt-5

# 발음 평가 (플랜 10) — 모두 비워두면 로컬 사이드카 기본 주소(http://localhost:8000)를 본다.
# 사이드카가 꺼져 있으면 스피킹 화면은 브라우저 받아쓰기 모드로 동작한다(정상 상태).
# 설치·기동은 설정 → 음성 인식 화면의 버튼(개발 모드) 또는 pwsh lib/pronounce/install-python.ps1 -Run
#PRONUNCIATION_URL=http://localhost:8000
# 상용 API(PoC·대안). 키는 클라이언트에 나가지 않는다 — 서버가 오디오를 경유시킨다
#SPEECHACE_KEY=<SPEECHACE_KEY>
#SPEECHACE_DIALECT=en-us
# 둘 다 설정했을 때 강제 선택: openpronounce | speechace (미설정=로컬 우선)
#PRONUNCIATION_BACKEND=openpronounce
